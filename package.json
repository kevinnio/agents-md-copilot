{
  "name": "agents-md-copilot",
  "displayName": "AGENTS.md for Copilot",
  "description": "Injects ~/AGENTS.md into GitHub Copilot's system instructions.",
  "version": "0.0.1",
  "publisher": "kevinperez",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kevinnio/agents-md-copilot"
  },
  "keywords": [
    "copilot",
    "github-copilot",
    "instructions",
    "ai",
    "agents"
  ],
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "AI"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "AGENTS.md for Copilot",
      "properties": {
        "agentsMd.enableForReview": {
          "type": "boolean",
          "default": false,
          "description": "Inject AGENTS.md into Copilot review selection instructions."
        },
        "agentsMd.enableForCommitMessages": {
          "type": "boolean",
          "default": false,
          "description": "Inject AGENTS.md into Copilot commit message generation instructions."
        },
        "agentsMd.enableForTests": {
          "type": "boolean",
          "default": false,
          "description": "Inject AGENTS.md into Copilot test generation instructions."
        }
      }
    }
  },
  "scripts": {
    "compile": "node ./node_modules/typescript/bin/tsc -p ./",
    "watch": "node ./node_modules/typescript/bin/tsc -watch -p ./",
    "vscode:prepublish": "node ./node_modules/typescript/bin/tsc -p ./",
    "lint": "node_modules/.bin/eslint src",
    "package": "node_modules/.bin/vsce package --no-dependencies --skip-license"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.93.0",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "@vscode/vsce": "^3.0.0",
    "eslint": "^10.4.1",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.60.0"
  }
}
